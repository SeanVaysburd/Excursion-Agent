# ---------------------------------------------------------------------------
# Excursion Agent configuration.  Copy to .env and edit:   cp .env.example .env
# The quickstart path needs NO key and no account: install Ollama, pull the
# model, and run.  See README "Quickstart".
# ---------------------------------------------------------------------------

# Which LLM backs the agents and the weekly critic.
#   ollama      (default) free local model, no account. Requires the Ollama
#               app running and:  ollama pull llama3.1:8b   (~5 GB, CPU-slow)
#   claude-sdk  Claude via a Claude subscription's Agent SDK credit. One-time
#               setup: run the bundled CLI's `setup-token` (README "providers")
#               and paste the printed token below; no API key -- and the app
#               REFUSES to run if ANTHROPIC_API_KEY is also set, so
#               subscription auth can't be silently shadowed into API billing.
LLM_PROVIDER=ollama
#LLM_PROVIDER=claude-sdk

# Claude model id used by the claude-sdk provider.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local model used by the ollama provider.
OLLAMA_MODEL=llama3.1:8b

# Optional, free (ebird.org/api/keygen). Unlocks live eBird data and the
# life-list "lifer bonus" (scenario S4). Without it the nature agent runs on
# iNaturalist only and says so in its logs and self-report.
#EBIRD_API_KEY=

# Optional home origin for weather + nature-radius queries. Defaults to an
# APPROXIMATE Brooklyn centroid (privacy: not a real address). The committed
# travel-time matrix stays anchored to the sample origin either way -- it is
# the documented swappable seam, see README.
#HOME_LAT=40.67
#HOME_LON=-73.97

# Required only for LLM_PROVIDER=claude-sdk (from the one-time setup-token run).
#CLAUDE_CODE_OAUTH_TOKEN=
